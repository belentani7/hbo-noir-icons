# BELENTANI NEURAL ICONS / optional server-side AI
# Default website works without provider keys or private GitHub access.
#
# DO NOT configure VITE_MINIMAX_API_KEY or any secret with a VITE_ prefix.
# Client-side Vite environment variables are public by design.

# Optional public UI feature flag (does NOT authorize server independently)
VITE_ICON_BRIEF_ENABLED=false

# SERVER ONLY: Vercel function /api/icon-brief. Keep off until spend caps,
# edge/global rate limits and domain restrictions are configured.
ICON_BRIEF_API_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01

# Historical templates mentioned GEMINI_API_KEY and APP_URL.
# They are NOT used by the current studio and not needed to run locally.
